{
  "title": "Email review findings",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "description": "Path to the email file, relative to the studio folder."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line number where the problem is."
          },
          "severity": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "problem": {
            "type": "string",
            "description": "What is wrong, and which rule it breaks."
          },
          "fix": {
            "type": "string",
            "description": "A specific change that fixes it."
          }
        },
        "required": ["file", "line", "severity", "problem", "fix"],
        "additionalProperties": false
      }
    }
  },
  "required": ["findings"],
  "additionalProperties": false
}
